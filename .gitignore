# === Rust build artifacts ===
/target/

# === OS-specific ===
**/*.DS_Store
**/*.swp
**/*~
*.tmp
*.bak

# === Editor/IDE files ===
.idea/
.vscode/

# === Binary artifacts ===
*.exe
*.dll
*.so
*.dylib
*.out

# cargo-mutants writes `mutants.out`, which `*.out` above already covers, and
# rotates the previous run to `mutants.out.old`, which it does not: the suffix
# is no longer `.out`. 1.9MB of mutation output reached a commit that way once.
mutants.out*/
*.log

# === Coverage ===
/coverage/
/kcov-*

# === Secrets ===
.env
.env.*

# === Agent harness (local only) ===
.claude/settings.local.json
.claude/worktrees/
.claude/.cc-writes/
